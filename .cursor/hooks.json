{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/mark-needs-build.mjs"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "node .cursor/hooks/mark-needs-build.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/build-if-needed.mjs",
        "timeout": 600,
        "loop_limit": 3
      }
    ]
  }
}
